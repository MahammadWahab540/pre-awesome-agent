rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function is_authenticated() {
      return request.auth != null;
    }

    function is_user_owner(user_id) {
      return is_authenticated() && request.auth.uid == user_id;
    }

    function valid_user_document() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['email']) || request.resource.data.email is string)
        && (!request.resource.data.keys().hasAny(['displayName']) || request.resource.data.displayName is string)
        && (!request.resource.data.keys().hasAny(['photoURL']) || request.resource.data.photoURL is string);
    }

    function valid_user_session_document() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'status',
          'lastSeenAt',
          'createdAt',
          'updatedAt',
          'metadata'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status is string)
        && (!request.resource.data.keys().hasAny(['lastSeenAt']) || request.resource.data.lastSeenAt is timestamp);
    }

    // Sensitive user profile documents: scoped to the authenticated owner only.
    match /users/{userId} {
      allow read: if is_user_owner(userId);
      allow create: if is_user_owner(userId) && valid_user_document();
      allow update: if is_user_owner(userId)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && valid_user_document();
      allow delete: if false;
    }

    // User session records: only the owning authenticated user can access.
    match /user_sessions/{sessionId} {
      allow read: if is_authenticated() && resource.data.userId == request.auth.uid;
      allow create: if is_authenticated() && valid_user_session_document();
      allow update: if is_authenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && valid_user_session_document();
      allow delete: if is_authenticated() && resource.data.userId == request.auth.uid;
    }

    // Baseline rule for all other collections/documents.
    // This blocks anonymous access while allowing authenticated traffic.
    match /{document=**} {
      allow read, write: if is_authenticated();
    }
  }
}
